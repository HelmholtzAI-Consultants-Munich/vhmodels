{
  "schema_version": "1.0",
  "model": {
    "id": "prottrans",
    "version": "1.0.0",
    "description": "State of the art pre-trained models for proteins",
    "homepage": "https://huggingface.co/collections/virtual-human-chc/prottrans"
  },
  "implementation": {
    "class_path": "ProtTrans.model.ProtTrans",
    "capabilities": ["embed"]
  },
  "supported_platforms": ["linux-x86_64"],
  "runtimes": {
    "conda": {
      "env_name": "vhmodels-prottrans",
      "platforms": {
        "linux-x86_64": { "environment": "environment.linux-x86_64.yml" }
      }
    },
    "apptainer": {
      "platform": "linux-x86_64",
      "python": "3.11",
      "requirements": "requirements.linux-x86_64.txt"
    }
  },
  "sources": {
    "tokenizer": {
      "type": "huggingface",
      "repo_id": "virtual-human-chc/{variant}"
    },
    "weights": {
      "type": "huggingface",
      "repo_id": "virtual-human-chc/{variant}"
    }
  }
}
