{
  "schema_version": "1.0",
  "model": {
    "id": "nicheformer",
    "version": "1.0.0",
    "description": "A transformer-based foundation model for single-cell and spatial omics",
    "homepage": "https://huggingface.co/virtual-human-chc/Nicheformer"
  },
  "implementation": {
    "class_path": "Nicheformer.model.Nicheformer",
    "capabilities": ["embed"]
  },
  "supported_platforms": ["linux-x86_64"],
  "runtimes": {
    "conda": {
      "env_name": "vhmodels-nicheformer",
      "platforms": {
        "linux-x86_64": { "environment": "environment.linux-x86_64.yml" }
      }
    },
    "apptainer": {
      "platform": "linux-x86_64",
      "python": "3.10",
      "requirements": "requirements.linux-x86_64.txt",
      "torch_backend": "cu126"
    }
  },
  "sources": {
    "weights": {
      "type": "huggingface",
      "repo_id": "virtual-human-chc/Nicheformer"
    }
  }
}
