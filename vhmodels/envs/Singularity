Bootstrap: docker
From: mambaorg/micromamba:latest

%files
    context /app

%post
    apt-get update && apt-get install -y \\
        git \\
        curl \\
        build-essential \\
        && rm -rf /var/lib/apt/lists/*

    micromamba create -y -n vhmodels-{project} -f /app/vhmodels/models/{project}/environment.yml
    micromamba clean --all --yes
    micromamba run -n vhmodels-{project} pip install -e /app

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/envs/vhmodels-{project}/bin:$PATH

%runscript
    exec micromamba run -n vhmodels-{project} pytest /app/tests/test_{project}.py