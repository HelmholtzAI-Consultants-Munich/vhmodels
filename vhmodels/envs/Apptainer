Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.12.3
Stage: uv

Bootstrap: docker
From: ubuntu:24.04
Stage: runtime

%setup
    mkdir -p "$APPTAINER_ROOTFS/opt/vhmodels-build-cache"

%files from uv
    /uv /usr/local/bin/uv

%files
    vhmodels /opt/vhmodels-src/vhmodels

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    export TMPDIR=/var/tmp
    export UV_PYTHON_INSTALL_DIR=/opt/python
    export UV_PYTHON_INSTALL_BIN=0
    export UV_CACHE_DIR=/opt/vhmodels-build-cache
    export UV_PYTHON_CACHE_DIR=/opt/vhmodels-build-cache/python
    export UV_LINK_MODE=copy
    export UV_HTTP_TIMEOUT=120
    export UV_HTTP_RETRIES=10

    mkdir -p "$UV_CACHE_DIR" "$UV_PYTHON_CACHE_DIR"

    apt-get update
    apt-get install -y --no-install-recommends ca-certificates git build-essential libgl1 libglib2.0-0t64 libgomp1 libstdc++6 libxext6 libxrender1
    rm -rf /var/lib/apt/lists/*

    uv python install --managed-python "cpython-{python_version}-linux-x86_64-gnu"
    uv venv --managed-python --python "cpython-{python_version}-linux-x86_64-gnu" /opt/venv
    uv pip install --python /opt/venv/bin/python {torch_backend_arg} {exclude_arg} --requirements /opt/vhmodels-src/vhmodels/models/{model_dir}/{requirements_file}
    PYTHONPATH=/opt/vhmodels-src /opt/venv/bin/python -c "import vhmodels.models.{model_dir}.model"

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/opt/vhmodels-src
